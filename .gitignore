# Root gitignore
.DS_Store
*.log
.idea/
*.iml
.vscode/

# Backend
backend/target/
backend/.mvn/wrapper/maven-wrapper.jar
!backend/.mvn/wrapper/maven-wrapper.properties
backend/*.log

# Frontend
frontend/node_modules/
frontend/dist/
frontend/dist-ssr/
frontend/*.local
frontend/.env.local
frontend/.env.*.local
frontend/coverage/

# Scratch & temp
scratch/
tmp/
