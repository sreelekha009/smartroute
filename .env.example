# SmartRoute Environment Configuration Example
# Copy this file to .env if you wish to override default properties.

# Backend Spring Profile: 'local' (H2 in-memory) or 'postgres' (PostgreSQL container)
SPRING_PROFILES_ACTIVE=local

# PostgreSQL Configuration (used when SPRING_PROFILES_ACTIVE=postgres)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=smartroute
POSTGRES_USER=smartroute
POSTGRES_PASSWORD=smartroute_dev_password

# Backend Port
SERVER_PORT=8080

# Frontend API URL
VITE_API_BASE_URL=http://localhost:8080/api
